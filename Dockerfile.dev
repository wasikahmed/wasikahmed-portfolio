# Development image — hot reload via `docker compose watch`, not for production.
# See PLAN.md §4 for the multi-stage production build (Phase 7).
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate

# Installed separately from the rest of the source so this layer only
# rebuilds when dependencies actually change — `docker compose watch`
# triggers exactly that via its `rebuild` action on these two files.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000

# -H 0.0.0.0 is required: Next's default bind (localhost) is unreachable
# through Docker's port mapping from the host.
CMD ["pnpm", "exec", "next", "dev", "-H", "0.0.0.0", "-p", "3000"]
