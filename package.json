{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:dry": "tsx --env-file=.env scripts/seed.ts --dry-run",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "seed:e2e-admin": "tsx --env-file=.env scripts/seed-e2e-admin.ts",
    "seed:e2e-invite": "tsx --env-file=.env scripts/seed-e2e-invite.ts",
    "build:scripts": "esbuild scripts/seed.ts scripts/seed-admin.ts --bundle --platform=node --target=node22 --format=esm --out-extension:.js=.mjs --outdir=dist-scripts --external:mongoose --external:@node-rs/argon2 --log-level=warning"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.1.0",
    "@scalar/api-reference-react": "^0.9.66",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "mongoose": "^9.9.4",
    "motion": "^13.1.1",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-mdx-remote-client": "^2.1.12",
    "nodemailer": "^10.0.13",
    "otpauth": "^9.5.1",
    "probe-image-size": "^7.4.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "simple-icons": "^16.33.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/probe-image-size": "^7.2.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^3"
  }
}
