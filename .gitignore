# docker
docker-data/

# media library uploads — local disk in dev; Phase 7 swaps this for S3/R2
# without changing the Media model, which already only stores a URL.
# Ignore the contents but not .gitkeep — that placeholder is what keeps
# public/uploads/ (and therefore public/ itself) present after a fresh
# checkout. Without it, a clean `git clone` has no public/ directory at
# all, which is exactly what broke the first CI Docker build: the
# Dockerfile's `COPY --from=builder /app/public ./public` had nothing to
# copy.
/public/uploads/*
!/public/uploads/.gitkeep
