npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*-debug.log*
*.log
logs/

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# docker
docker-data/

# media library uploads — no longer written to (PLAN.md W15 item 1 moved
# the media library to Cloudinary; see src/server/cloudinary.ts). This
# directory is otherwise vestigial now, kept only because .gitkeep is what
# keeps public/uploads/ (and therefore public/ itself, which has nothing
# else in it) present after a fresh checkout — the Dockerfile's
# `COPY --from=builder /app/public ./public` needs public/ to exist.
/public/uploads/*
!/public/uploads/.gitkeep
