# Copy to .env.local for development, or .env for docker compose.
# Never commit a filled-in .env* file — see .gitignore.

# --- Core --------------------------------------------------------------------
# Canonical site domain, no protocol. Flows into NEXT_PUBLIC_SITE_URL,
# canonicals, sitemap/OG/RSS URLs, and CSP report-uri. Must be set for
# production — nothing currently fails the build if it's left unset, so
# double-check it by hand before deploying.
DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Data layer ----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/portfolio

# --- Production only -----------------------------------------------------------
# Not read by `pnpm dev` or the dev compose stack — docker-compose.prod.yml
# builds MONGODB_URI above from these instead of using it directly. The
# deploy workflow writes this whole block from GitHub Actions secrets/vars;
# nothing here needs a value for local development.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
DOCKERHUB_USERNAME=
IMAGE_TAG=
PORT_HOST=

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Used only by `pnpm seed:admin` to bootstrap the first admin account —
# not read anywhere else. Change the account's email afterward from
# /admin/security if needed.
ADMIN_EMAIL=
# Production only — not read by `pnpm dev`/the dev compose stack, and unset
# there is fine since Auth.js's Host-header fallback works for a plain
# localhost bind. In production this app runs with HOSTNAME=0.0.0.0 (Docker
# requires it), and Auth.js v5's fallback resolution leaks that bind address
# into absolute URLs it builds (e.g. the sign-out redirect) instead of the
# real domain. deploy.yml sets this from NEXT_PUBLIC_SITE_URL automatically.
AUTH_URL=
# Google OAuth client (console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application). Authorized redirect
# URI must be exactly {origin}/api/auth/callback/google — both
# http://localhost:4000/api/auth/callback/google (dev) and the production
# origin need to be registered there. Auth.js reads these two exact names
# automatically (v5's convention for `AUTH_<PROVIDER>_ID/SECRET`) — no
# other config needed. Both unset = no Google provider registered at all,
# and the "Sign in with Google" button doesn't render (PLAN.md W11a).
# Google sign-in never creates an account — src/server/auth.ts's signIn
# callback rejects any email without an existing User document, same "no
# signup route" rule as everything else in AGENTS.md §7.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Media (PLAN.md W15 item 1) -----------------------------------------------
# Cloudinary — the media library's storage backend (src/server/cloudinary.ts,
# swapped in for the local-disk /public/uploads this app started with). All
# three are required for any upload to succeed; unset locally just means the
# admin media page's upload form 502s until you fill these in.
# Account → dashboard shows cloud name/API key/API secret directly.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Every asset this app uploads or deletes is scoped to this folder — the
# same Cloudinary account may hold other projects' media, and this is what
# keeps this app from ever touching theirs. Defaults to
# `portfolio/admin/media` if left unset.
CLOUDINARY_FOLDER=portfolio/admin/media

# --- Leads pipeline ----------------------------------------------------------
# Notification email for a new contact-form lead, sent via Gmail SMTP with
# an app password (Google Account → Security → 2-Step Verification → App
# passwords). Read by src/server/email.ts. Both unset = the route logs and
# skips sending instead of failing the submission.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Cloudflare Turnstile, both read at request time by src/server/turnstile.ts:
# the site key is handed to the widget as a prop (turnstileSiteKey()), the
# secret verifies the token. The site key is deliberately NOT NEXT_PUBLIC_ —
# that would inline it into the client bundle at build time, and the Docker
# build never has it (it shipped undefined to production that way). Both
# unset = verification is skipped (local dev only — never true in
# production). Set them as a pair: a secret without a site key rejects
# every submission, since no widget renders to produce a token. Production's real site key is
# domain-locked and will not render on localhost (error 110200) — for local
# dev, use one of Cloudflare's documented always-pass test keys instead:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E2E only (AGENTS.md §2) --------------------------------------------------
# Read only by scripts/seed-e2e-admin.ts, never by the app itself. Creates a
# deterministic, no-TOTP admin account for e2e/admin.spec.ts to log in with —
# never point this at a real/production database.
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=
# Read only by scripts/seed-e2e-invite.ts and e2e/invite.spec.ts (PLAN.md
# W14 item 6) — a deterministic, pre-accepted-state 'viewer' invite so the
# suite can drive the real accept-invite → login → permission-ceiling
# round trip without depending on an actual email being sent. Never point
# this at a real/production database.
E2E_INVITE_EMAIL=e2e-invite@example.com
E2E_INVITE_TOKEN=

# --- Polish --------------------------------------------------------------------
# Umami analytics — an externally hosted Umami (v3), reached through this
# app's own first-party relay at /x/ (src/server/umami-proxy.ts), never
# loaded from the Umami host directly. Read at request time by
# src/components/analytics/analytics.tsx and the relay; unset either one and
# no tracking script renders and /x/ 404s. Server-only on purpose (no
# NEXT_PUBLIC_ prefix): the browser only ever sees /x/ paths and the ID.
# UMAMI_URL is the instance's base URL, e.g. https://analytics.example.com
# — not a script URL. UMAMI_WEBSITE_ID is from Umami → Websites → Edit.
# For local development, point at a separate "dev" website in Umami so
# localhost traffic never lands in production's numbers (the tracker only
# reports from NEXT_PUBLIC_SITE_URL's hostname either way).
UMAMI_URL=
UMAMI_WEBSITE_ID=
