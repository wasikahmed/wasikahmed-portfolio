# Copy to .env.local for development, or .env for docker compose.
# Never commit a filled-in .env* file — see .gitignore.

# --- Core (Phase 0) ---------------------------------------------------------
# Canonical site domain, no protocol. Flows into NEXT_PUBLIC_SITE_URL,
# canonicals, sitemap/OG/RSS URLs, the Cloudflare Access policy, CSP
# report-uri, and Resend's from-address. `pnpm verify:env` fails the build
# if this is still unset — see PLAN.md §3 "Tunnel ingress".
DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Data layer (Phase 3) ---------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/portfolio

# --- Production only (Phase 7) ----------------------------------------------
# Not read by `pnpm dev` or the dev compose stack — docker-compose.prod.yml
# builds MONGODB_URI above from these instead of using it directly. The
# deploy workflow writes this whole block from GitHub Actions secrets/vars;
# nothing here needs a value for local development.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
DOCKERHUB_USERNAME=
IMAGE_TAG=
PORT_HOST=

# --- Auth (Phase 4) ---------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Used only by `pnpm seed:admin` to bootstrap the first admin account —
# not read anywhere else. Change the account's email afterward from
# /admin/settings/security if needed.
ADMIN_EMAIL=
# Cloudflare Access — used to verify the CF-Access-Jwt-Assertion header
# at the origin so the app trusts the edge cryptographically, not by
# assumption. See PLAN.md §3 "Auth — defense in depth".
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# --- Leads pipeline (Phase 5) -----------------------------------------------
# Notification email for a new contact-form lead, sent via Gmail SMTP with
# an app password (Google Account → Security → 2-Step Verification → App
# passwords). Read by src/server/email.ts. Both unset = the route logs and
# skips sending instead of failing the submission.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Cloudflare Turnstile. The site key is NEXT_PUBLIC_ because the widget
# needs it in the browser; the secret key is server-only and verifies the
# token in src/server/turnstile.ts. Both unset = verification is skipped
# (local dev only — never true in production). Production's real site key is
# domain-locked and will not render on localhost (error 110200) — for local
# dev, use one of Cloudflare's documented always-pass test keys instead:
# site key 1x00000000000000000000AA, secret key 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E2E only (PLAN.md W6) --------------------------------------------------
# Read only by scripts/seed-e2e-admin.ts, never by the app itself. Creates a
# deterministic, no-TOTP admin account for e2e/admin.spec.ts to log in with —
# never point this at a real/production database.
E2E_ADMIN_EMAIL=e2e-admin@example.com
E2E_ADMIN_PASSWORD=

# --- Polish (Phase 6) --------------------------------------------------------
# Umami analytics, self-hosted or cloud — read by src/app/(site)/layout.tsx,
# which only injects the tracking script when both are set (public site
# only, never /admin). proxy.ts's CSP allow-lists the script URL's origin
# in connect-src automatically from NEXT_PUBLIC_UMAMI_SCRIPT_URL.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
